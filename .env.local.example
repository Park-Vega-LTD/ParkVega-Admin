# ParkVega Admin — Environment Variables
# Copy this file to .env.local and replace placeholder values with real secrets.
# Only NEXT_PUBLIC_* variables reach the browser; everything else is server-only.

# Server-only base URL of the ParkVega REST API (park-vega-services). Same
# value as the public website uses. (NEXT_PUBLIC_API_URL is still read as a
# fallback for older environments.)
PARK_VEGA_API_URL=https://api.parkvega.com

# Origin of the public website (parkvega-web). Used for "view on site" links.
NEXT_PUBLIC_PUBLIC_SITE_URL=https://parkvega.com

# Server-only. Must equal the REST API's JWT secret: the proxy and layouts
# verify the `pv_admin_access` cookie and read its `role` claim with it.
JWT_SECRET=PLACEHOLDER_REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Server-only. After a staff edit, the console calls
# POST ${PUBLIC_SITE_URL}/api/revalidate with this secret so the public site
# shows the change immediately. Must match REVALIDATE_SECRET in parkvega-web.
# Leave either unset to skip it (changes then appear within 60 seconds).
PUBLIC_SITE_URL=https://parkvega.com
REVALIDATE_SECRET=PLACEHOLDER_REPLACE_WITH_A_STRONG_RANDOM_SECRET
